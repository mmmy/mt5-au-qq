# TradingView
# Leave blank to derive the webhook URL from the browser's current Host.
TRADINGVIEW_WEBHOOK_URL=
TV_ALERT_NAME_PREFIX=MT5_AU::GOLD_PRICE::
TV_ORIGIN=https://cn.tradingview.com
TV_REQUEST_TIMEOUT_SECONDS=20

# MetaTrader 5
# Leave blank to auto-detect the running/default MT5 terminal.
MT5_TERMINAL_PATH=
MT5_SYMBOL=XAUUSD
MT5_VOLUME=0.01
MT5_MAX_VOLUME=0.10
MT5_MAGIC=26082301
MT5_DEVIATION=20
MT5_EMERGENCY_SL_DISTANCE=20
MT5_DEMO_ONLY=true

# Trading runtime
SIGNAL_MAX_AGE_SECONDS=180
TRADING_ENABLED_AT_START=false

# Local files (optional overrides)
# TV_COOKIE_FILE=F:\test\mt5-au-qq\.tv-cookie
# TV_PAYLOAD_FILE=F:\test\mt5-au-qq\payload.json
# DATABASE_FILE=F:\test\mt5-au-qq\data\trading.db
